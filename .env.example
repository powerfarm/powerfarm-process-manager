# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Durable process memory. In password mode, DATABASE_URL enables the process
# graph while chat history remains in browser storage.
DATABASE_URL=

# Optional production chat mode. Configure every remaining value in this
# section to switch chat storage and auth to Neon, Upstash, and Sign in with
# Vercel.
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: override the marketing team's Vercel Connect integrations.
NOTION_CONNECTOR=notion/marketing-team
RESEND_CONNECTOR=resend/marketing-team

# Optional: enable social scheduling for the social media coordinator.
TYPEFULLY_API_KEY=
